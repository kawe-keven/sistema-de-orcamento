{
  "name": "freelancer-quotes-workspace",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace apps/api run dev",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "db:migrate": "npm --workspace apps/api run prisma:migrate",
    "db:generate": "npm --workspace apps/api run prisma:generate"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}
