generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum QuoteStatus { DRAFT SENT VIEWED APPROVED DECLINED PAID }
model User { id String @id @default(uuid()) email String @unique passwordHash String createdAt DateTime @default(now()) quotes Quote[] auditLogs AuditLog[] refreshTokens RefreshToken[] }
model RefreshToken { id String @id @default(uuid()) tokenHash String @unique userId String expiresAt DateTime revokedAt DateTime? user User @relation(fields: [userId], references: [id], onDelete: Cascade) createdAt DateTime @default(now()) }
model Client { id String @id @default(uuid()) name String email String @unique phone String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt quotes Quote[] }
model Quote { id String @id @default(uuid()) userId String clientId String project String description String @db.Text items Json subtotal Decimal @db.Decimal(12,2) discount Decimal @default(0) tax Decimal @default(0) total Decimal @db.Decimal(12,2) status QuoteStatus @default(DRAFT) publicTokenHash String? @unique publicTokenExpiresAt DateTime? expiresAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt user User @relation(fields: [userId], references: [id]) client Client @relation(fields: [clientId], references: [id]) payments Payment[] auditLogs AuditLog[] }
model Template { id String @id @default(uuid()) userId String name String structure Json createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Payment { id String @id @default(uuid()) quoteId String provider String providerId String @unique amount Decimal @db.Decimal(12,2) status String createdAt DateTime @default(now()) quote Quote @relation(fields: [quoteId], references: [id]) }
model AuditLog { id String @id @default(uuid()) userId String? quoteId String? action String metadata Json? createdAt DateTime @default(now()) user User? @relation(fields: [userId], references: [id]) quote Quote? @relation(fields: [quoteId], references: [id]) }
